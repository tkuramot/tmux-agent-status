#!/usr/bin/env bash
# pane-status: records the state of what runs in each tmux pane. See README.

set -u
set -f
shopt -u patsub_replacement 2>/dev/null

# Follow symlinks (e.g. ~/.local/bin/pane-status); `readlink -f` is not portable.
source="${BASH_SOURCE[0]}"
while [ -L "$source" ]; do
	dir="$(cd -P "$(dirname "$source")" && pwd)"
	source="$(readlink "$source")"
	case "$source" in /*) ;; *) source="$dir/$source" ;; esac
done
ROOT="$(cd -P "$(dirname "$source")/.." && pwd)"
CLI="$ROOT/bin/pane-status"
unset source dir

# shellcheck source=lib/common.sh
. "$ROOT/lib/common.sh"
# shellcheck source=lib/agent.sh
. "$ROOT/lib/agent.sh"
# shellcheck source=lib/gh.sh
. "$ROOT/lib/gh.sh"
# shellcheck source=lib/list.sh
. "$ROOT/lib/list.sh"

usage() {
	cat <<'EOF'
Usage: pane-status <group> <command> [arguments]

agent: agent state
  agent emit <agent> <event>  Apply the adapter's action for an event. For
                              agent hooks: discards stdin, prints nothing,
                              always exits 0.
  agent set <activity> [--pane P] [--agent A]
  agent clear [--pane P]
  agent seen [--pane P]       Mark the current activity as seen.
  agent check <agent>         Validate the agent's adapter map.
  agent hooks <agent> [--install]
                              Print hook settings generated from the map;
                              with --install, merge them into Claude Code's
                              settings.json instead (needs jq).

pr: pull requests
  pr refresh                  Make the poller look up pull requests now.
  pr poll                     Run the poller (the plugin starts it).

Every source:
  list [--require-schema N]   Print every pane's state as JSON.
  version                     Print the plugin's version.

Activities: working waiting idle error. --pane defaults to $TMUX_PANE.
EOF
}

# An explicit empty target is an error rather than $TMUX_PANE.
resolve_pane() {
	local id
	[ -n "$1" ] || return 1
	id="$(tmux display-message -p -t "$1" '#{pane_id}' 2>/dev/null)"
	case "$id" in %*) printf '%s' "$id" ;; *) return 1 ;; esac
}

# Sets PANE (from --pane, else $TMUX_PANE), AGENT and POSITIONAL.
parse_args() {
	local target="${TMUX_PANE:-}"
	AGENT="" POSITIONAL=()
	while [ "$#" -gt 0 ]; do
		case "$1" in
		--pane | --agent)
			[ "$#" -ge 2 ] || die "$1 requires a value"
			if [ "$1" = --pane ]; then target="$2"; else AGENT="$2"; fi
			shift 2
			;;
		--) shift; POSITIONAL+=("$@"); break ;;
		-*) die "unknown option: $1" ;;
		*) POSITIONAL+=("$1"); shift ;;
		esac
	done
	PANE="$(resolve_pane "$target")" || die "no such pane: ${target:-\$TMUX_PANE}"
}

# The event is applied before stdin is drained, so a large payload does not
# delay it. Draining is deadline-bound, so a writer that keeps stdin open
# cannot hang the agent.
cmd_emit() {
	emit_event "$@" >/dev/null 2>&1
	if [ ! -t 0 ]; then
		local end=$((SECONDS + 2))
		while [ "$SECONDS" -lt "$end" ] && IFS= read -r -t 1 _; do :; done
	fi
	exit 0
}

cmd_set() {
	parse_args "$@"
	[ "${#POSITIONAL[@]}" -eq 1 ] || die "usage: pane-status agent set <activity> [--pane P] [--agent A]"
	is_activity "${POSITIONAL[0]}" || die "unknown activity: ${POSITIONAL[0]} (expected: $ACTIVITIES)"
	[ -z "$AGENT" ] || is_valid_agent_name "$AGENT" || die "invalid agent name: $AGENT"
	set_activity "$PANE" "${POSITIONAL[0]}" "$AGENT"
}

cmd_clear() {
	parse_args "$@"
	[ "${#POSITIONAL[@]}" -eq 0 ] || die "usage: pane-status agent clear [--pane P]"
	clear_agent "$PANE"
}

cmd_seen() {
	parse_args "$@"
	[ "${#POSITIONAL[@]}" -eq 0 ] || die "usage: pane-status agent seen [--pane P]"
	mark_seen "$PANE"
}

# The version is the plugin checkout's commit, so it needs no bumping. A
# directory that is not itself the top of a git checkout (e.g. inside another
# repository) has none: there, the prefix is not empty or rev-parse fails.
cmd_version() {
	local version=unknown
	# The environment must not point git at another repository.
	unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR
	if [ -z "$(git -C "$ROOT" rev-parse --show-prefix 2>/dev/null || echo outside)" ]; then
		version="$(git -C "$ROOT" describe --tags --always --dirty 2>/dev/null)" || version=unknown
	fi
	printf 'pane-status %s\n' "$version"
}

cmd_check() {
	local map
	is_valid_agent_name "${1:-}" || die "usage: pane-status agent check <agent>"
	map="$(find_map "$1")" || die "no adapter for agent: $1"
	validate_map "$map" || exit 1
	printf '%s: ok\n' "$map"
}

# Settings are in Claude Code's shape, so only it can be installed into.
cmd_hooks() {
	local map
	case "$#:${2:-}" in 1: | 2:--install) ;; *) set -- "" ;; esac
	is_valid_agent_name "$1" || die "usage: pane-status agent hooks <agent> [--install]"
	map="$(find_map "$1")" || die "no adapter for agent: $1"
	validate_map "$map" || die "fix the map first: $map"
	if [ "$#" -eq 1 ]; then
		print_hooks "$1" "$map"
	elif [ "$1" = claude-code ]; then
		[ -n "${CLAUDE_CONFIG_DIR:-}${HOME:-}" ] || die "neither CLAUDE_CONFIG_DIR nor HOME is set"
		install_hooks "$1" "$map" "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
	else
		die "--install supports claude-code only; merge the printed settings yourself"
	fi
}

cmd_agent() {
	local cmd="${1:-}"
	[ "$#" -eq 0 ] || shift
	case "$cmd" in
	emit) cmd_emit "$@" ;;
	set) cmd_set "$@" ;;
	clear) cmd_clear "$@" ;;
	seen) cmd_seen "$@" ;;
	check) cmd_check "$@" ;;
	hooks) cmd_hooks "$@" ;;
	-h | --help | help) usage ;;
	*) die "unknown command: agent ${cmd:-(none)} (see pane-status --help)" ;;
	esac
}

cmd_pr() {
	case "${1:-}" in
	refresh) cmd_refresh ;;
	poll) cmd_poll ;;
	-h | --help | help) usage ;;
	*) die "unknown command: pr ${1:-(none)} (see pane-status --help)" ;;
	esac
}

main() {
	local cmd="${1:-}"
	[ "$#" -eq 0 ] || shift
	case "$cmd" in
	agent) cmd_agent "$@" ;;
	pr) cmd_pr "$@" ;;
	list) cmd_list "$@" ;;
	version | --version) cmd_version ;;
	-h | --help | help) usage ;;
	'') usage >&2; exit 2 ;;
	*) die "unknown command: $cmd (see pane-status --help)" ;;
	esac
}

main "$@"
