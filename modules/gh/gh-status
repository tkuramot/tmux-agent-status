#!/usr/bin/env bash
# gh-status: copies the pull request state of each pane's branch into pane options.

set -u

CURRENT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/helpers.sh
. "$CURRENT_DIR/../../scripts/helpers.sh"

CACHE_DIR="${XDG_CACHE_HOME:-${HOME:-}/.cache}/tmux-pane-status/gh"
US=$'\037'

# Prints "<number> <state> <checks>"; checks is "-" when there are none to show.
# shellcheck disable=SC2016
JQ='
[.statusCheckRollup[] | if .__typename == "StatusContext" then .state
	elif .status == "COMPLETED" then .conclusion else "PENDING" end] as $c
| (if .state == "MERGED" then "merged" elif .state == "CLOSED" then "closed"
	elif .isDraft then "draft" elif .reviewDecision == "APPROVED" then "approved"
	elif .reviewDecision == "CHANGES_REQUESTED" then "changes" else "review" end) as $s
| (if $s == "merged" or $s == "closed" or ($c | length) == 0 then "-"
	elif any($c[]; test("^(FAILURE|ERROR|TIMED_OUT|CANCELLED|ACTION_REQUIRED|STARTUP_FAILURE)$")) then "failure"
	elif any($c[]; test("^(PENDING|EXPECTED)$")) then "pending"
	else "success" end) as $k
| "\(.number) \($s) \($k)"'

# Prints the repository root and branch checked out in $1, one per line.
repo_branch() {
	local out ref
	out="$(git -C "$1" rev-parse --show-toplevel --symbolic-full-name HEAD 2>/dev/null)" || return 1
	ref="${out#*$'\n'}"
	case "$ref" in refs/heads/*) printf '%s\n%s' "${out%%$'\n'*}" "${ref#refs/heads/}" ;; *) return 1 ;; esac
}

# refresh CACHE_FILE REPO_ROOT
refresh() {
	local lock="$1.lock" out
	find "$lock" -maxdepth 0 -mmin +2 -exec rmdir {} \; 2>/dev/null
	mkdir "$lock" 2>/dev/null || return 0
	out="$(cd "$2" && gh pr view --json number,state,isDraft,reviewDecision,statusCheckRollup --jq "$JQ" 2>/dev/null)"
	printf '%s %s\n' "$(date +%s)" "$out" >"$1.tmp" && mv "$1.tmp" "$1"
	rmdir "$lock"
	"$CURRENT_DIR/gh-status" tick --cached
}

# Refreshes stale cache entries in the background unless --cached is given.
cmd_tick() {
	local cached="${1:-}" ttl now seen=" " pane path number state checks lines root file stamp n s k
	local -a args=()
	case " $(get_tmux_option @pane-status-modules 'agent gh') " in *" gh "*) ;; *) return 0 ;; esac
	command -v gh >/dev/null 2>&1 || return 0
	ttl="$(get_tmux_option @pane-status-gh-ttl 60)"
	now="$(date +%s)"
	mkdir -p "$CACHE_DIR" || return 0
	while IFS="$US" read -r pane path number state checks; do
		case "$seen" in *" $pane "*) continue ;; esac
		seen="$seen$pane "
		n="" s="" k=""
		if lines="$(repo_branch "$path")"; then
			root="${lines%%$'\n'*}"
			file="$CACHE_DIR/$(printf '%s' "$lines" | cksum | tr ' ' -)"
			stamp=0
			[ ! -r "$file" ] || read -r stamp n s k <"$file"
			[ "$k" != - ] || k=""
			[ -n "$cached" ] || [ $((now - stamp)) -lt "$ttl" ] ||
				refresh "$file" "$root" </dev/null >/dev/null 2>&1 &
		fi
		[ "$n:$s:$k" != "$number:$state:$checks" ] || continue
		if [ -n "$s" ]; then
			args+=(set-option -p -t "$pane" "$OPT_GH_NUMBER" "$n" \; set-option -p -t "$pane" "$OPT_GH_STATE" "$s" \;)
			if [ -n "$k" ]; then
				args+=(set-option -p -t "$pane" "$OPT_GH_CHECKS" "$k" \;)
			else
				args+=(set-option -pu -t "$pane" "$OPT_GH_CHECKS" \;)
			fi
		else
			args+=(set-option -pu -t "$pane" "$OPT_GH_NUMBER" \; set-option -pu -t "$pane" "$OPT_GH_STATE" \;
				set-option -pu -t "$pane" "$OPT_GH_CHECKS" \;)
		fi
	done < <(tmux list-panes -a -F "#{pane_id}$US#{pane_current_path}$US#{$OPT_GH_NUMBER}$US#{$OPT_GH_STATE}$US#{$OPT_GH_CHECKS}")
	[ "${#args[@]}" -eq 0 ] || tmux "${args[@]}"
}

case "${1:-}" in
tick) shift; cmd_tick "$@" ;;
*) printf 'Usage: gh-status tick [--cached]\n' >&2; exit 2 ;;
esac
